# Copy to .env and fill in. Never commit .env.

# Public HTTPS URL of this server (the cloudflared tunnel), no trailing slash
PUBLIC_URL=https://your-tunnel.trycloudflare.com

# Shared secret; must match ALERT_TOKEN in the watch's source/Config.mc
ALERT_TOKEN=change-me-to-a-long-random-string

# Secret part of the live demo page URL: <PUBLIC_URL>/display/<DISPLAY_TOKEN>
DISPLAY_TOKEN=change-me-random

# Name the coach uses
USER_NAME=Alex

# Cloudflare Workers AI (free daily allowance). Best practice: a token scoped to Workers AI only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Vapi (free tier: $5 credit + 1 free inbound number). Private API key from the Vapi dashboard.
VAPI_API_KEY=
# Random secret that becomes part of the URLs Vapi calls on this server
VAPI_PATH_TOKEN=change-me-random
# Your free Vapi number in +1... format
SUPPORT_NUMBER=

# Emails: Google Apps Script web app (see README) ...
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
# ... or Gmail SMTP (2-step verification on, then create an app password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
THERAPIST_EMAIL=
FRIEND_EMAIL=

# Free-tier guards
CALL_WAIT_SEC=600
MAX_CALL_SEC=420
MAX_ALERTS_PER_DAY=10

# Optional: if set, Claude (paid) writes the therapist summary instead of Workers AI
ANTHROPIC_API_KEY=
